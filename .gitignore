# OpenSCAD build outputs — STLs are usually transient, but the configurator
# preset STLs are tracked artifacts that the showcase viewer loads at runtime.
*.stl
!presets/*.stl
!docs/configurator/stls/*.stl

# Auto-generated render PNGs go under docs/assets/ and ARE committed there.
# Everywhere else, ignore:
/*.png
/studs/*.png
/latches/*.png
/patterns/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude Code project-local state
.claude/

# Local OpenSCAD config dumps
*.echo
*.csg
